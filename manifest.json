{
    "manifest_version": 3,
    "name": "Audio Controller",
    "version": "1.0",
    "content_scripts": [
      {
        "matches": ["https://ondoku3.com/*", "https://www.youtube.com/*",
                    "https://www.youtube-nocookie.com/*", "https://lyricstranslate.com/*",
                    "file:///*",
                    "https://*/*",
                    "http://*/*",
                    "<all_urls>"
                  ],
        "js": ["content.js"],
        "all_frames": true,
        "run_at": "document_idle"
      }
    ]
  }